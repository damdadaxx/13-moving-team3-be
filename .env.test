# 테스트 전용 설정 (git 에 올라간다. 실제 시크릿을 넣지 않는다)
# DB 는 localhost 의 *_test DB 만 허용된다 (test/assertTestDatabase.ts)
# 기본값은 Docker 테스트 DB (npm run test:db 로 실행, 5433 포트 — 로컬 Postgres 5432 와 겹치지 않게)
# Docker 없이 로컬 Postgres 를 쓰려면 이 파일 대신 셸에서 DATABASE_URL 을 넘긴다:
#   DATABASE_URL=postgresql://<user>:<pw>@localhost:5432/moving_test npm test
DATABASE_URL=postgresql://postgres:password@localhost:5433/moving_test
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
FRONTEND_URL=http://localhost:3000
SCHEDULER_ENABLED=false
# 루트 .env 의 운영 메일 키로 실제 메일이 나가지 않게 빈 값으로 고정 (빈 값이면 콘솔 출력)
RESEND_API_KEY=
# 루트 .env 의 Redis 에 붙지 않게 끈다 (빈 값이면 캐시 없이 DB 직접 조회)
REDIS_URL=
# 채팅(Supabase) 필수 환경변수. 클라이언트 생성만 하고 접속하지 않으므로 테스트에서는 더미 값으로 충분하다.
# 실제 Supabase 를 쓰는 테스트가 생기면 로컬 Supabase(supabase start) 주소로 바꾼다.
SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=test-supabase-secret-key

# S3 / CloudFront 테스트용 설정
# 실제 AWS 리소스가 아니라, env.ts의 필수값 검사를 통과하기 위한 값입니다.
AWS_REGION=ap-northeast-2
AWS_PRIVATE_BUCKET_NAME=moving-profile-test
CLOUDFRONT_DOMAIN=https://cloudfront.example.test