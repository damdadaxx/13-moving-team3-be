# Homebrew Postgres 로컬 예시 (비밀번호 없으면 USER:PASSWORD 대신 USER만)
DATABASE_URL=postgresql://USER@localhost:5432/moving
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=.example.com

# 소셜 로그인을 켤 때만 설정. 콜백 URL은 {API_BASE_URL}/auth/{google|kakao|naver}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
