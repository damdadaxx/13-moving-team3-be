# Homebrew Postgres 로컬 예시 (비밀번호 없으면 USER:PASSWORD 대신 USER만)
DATABASE_URL=postgresql://USER@localhost:5432/moving
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
PORT=3000
FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=.example.com

# 소셜 로그인을 켤 때만 설정.
# redirect_uri 는 프론트가 소유(예: {FRONTEND_URL}/auth/callback/{google|kakao|naver}).
# 프론트가 code 를 받아 POST {API}/auth/social/{provider} 로 전달한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
