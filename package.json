{
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck:watch": "tsc --noEmit --watch",
    "job:close-requests": "dotenv -e .env.development -- tsx src/scripts/closePastEstimateRequests.ts",
    "job:close-requests:prod": "dotenv -e .env.production -- tsx src/scripts/closePastEstimateRequests.ts",
    "db:migrate": "dotenv -e .env.development -- npx prisma migrate dev",
    "db:deploy": "dotenv -e .env.development -- npx prisma migrate deploy",
    "db:migrate:deploy": "dotenv -e .env.production -- npx prisma migrate deploy",
    "db:reset": "dotenv -e .env.development -- npx prisma migrate reset",
    "db:push": "dotenv -e .env.development -- npx prisma db push",
    "db:seed": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.development -- npx prisma studio",
    "db:chat:pull": "dotenv -e .env.development -- npx prisma db pull --config=prisma.chat.config.ts",
    "db:chat:studio": "dotenv -e .env.development -- npx prisma studio --config=prisma.chat.config.ts",
    "test": "jest --runInBand",
    "test:db": "docker run --name moving-test-db -e POSTGRES_PASSWORD=password -e POSTGRES_DB=moving_test -p 5433:5432 -d postgres:16",
    "test:coverage": "jest --runInBand --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@google/genai": "^2.28.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.31.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  }
}
