// 채팅 전용 DB (지금은 Supabase Cloud). 이 파일은 100% 읽기 전용 거울이다 — 절대 손으로
// 고치지 말 것. 런타임 조회/쓰기도 이 Prisma Client가 아니라 src/lib/supabase.ts(supabase-js,
// service_role)로 한다. 앱 코드는 이 스키마를 import하지 않는다.
//
// 실제 변경은 전부 supabase/migrations/*.sql에서만 한다 (테이블/인덱스/RLS/Realtime
// publication/Storage 버킷/check 제약 전부 포함) — RLS/publication/버킷 같은 Supabase 전용
// 문법은 애초에 Prisma schema 언어로 표현이 안 돼서, 표현 가능한 테이블/인덱스까지 전부
// SQL 쪽으로 몰아 이력을 하나로 유지한다.
//
// 절차: supabase/migrations/000N_xxx.sql 새로 작성 → Supabase SQL Editor에서 실행
//      → `npm run db:chat:pull` (= prisma db pull) 로 이 파일을 실제 DB 구조에 맞게 자동 갱신.
// 주의: db pull은 이 파일을 통째로 재생성해서 이 주석까지 날아간다 — pull 직후 이 헤더를
// 다시 붙여 넣을 것.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-chat"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  estimateId String   @map("estimate_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  moverId    String   @map("mover_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  content    String?
  imageUrl   String?  @map("image_url")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([estimateId, createdAt(sort: Desc), id(sort: Desc)], map: "chat_messages_room_cursor_idx")
  @@index([estimateId, isRead], map: "chat_messages_unread_idx", where: raw("(is_read = false)"))
  @@map("chat_messages")
}
